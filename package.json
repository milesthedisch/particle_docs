{
  "name": "particle_docs",
  "version": "1.0.0",
  "description": "API and Documentation.",
  "main": "server.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "webpack --config=./webpack.production.js",
    "build:dev": "webpack --config=./webpack.dev.js",
    "dev": "npm run build:dev & npm run serve",
    "serve": "nodemon -e js,handlebars,json --watch ./controllers --watch ./views server.js --watch ./examples | bunyan",
    "start": "node server.js",
    "create": "./bin/cli create example"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesthedisch/particle_docs.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/milesthedisch/particle_docs/issues"
  },
  "homepage": "https://github.com/milesthedisch/particle_docs#readme",
  "dependencies": {
    "bunyan": "^1.8.5",
    "express": "^4.21.0",
    "express-handlebars": "^7.1.0",
    "handlebars": "^4.7.8",
    "particle_library": "../particle_library"
  },
  "devDependencies": {
    "css-loader": "^7.1.0",
    "docopt": "^0.6.2",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "fs-extra": "^11.2.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "nodemon": "^3.1.0",
    "sass": "^1.77.0",
    "sass-loader": "^14.2.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-merge": "^6.0.0"
  }
}
